# Postgres connection string (Neon free tier).
# Never commit the real value — it belongs in .env.local and in Vercel.
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# Auth.js signing secret. Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-me"

# Public URL, used for OG/metadata links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Shared secret Vercel Cron sends as a bearer token to /api/cron/demo-reset.
# Leave unset locally to run the reset without a token.
CRON_SECRET=""
